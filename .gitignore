# ignore archive and hidden files
*.tar.gz
*.zip
.*.lock
.*.npz
.DS_Store

# ignore files generated by GROMACS
*.xtc
*.trr
*.edr
*.log
*.cpt

# ignore the build iterations
*iter*gro
*iter*tpr
*iter*top

# ignore test notebooks
test*.ipynb

# for now, ignore .pkl files (these contain data but are large)
*.pkl