integrator = md
dt = 0.002
nsteps = 5000000 ; 10,000 ps = 10 ns

continuation = no
constraints = h-bonds
constraint-algorithm = lincs

cutoff-scheme = Verlet
nstxout = 0
nstvout = 0
nstfout = 0
nstxout-compressed = 25000 ; 50 ps 

nstlist = 40
vdwtype = PME
coulombtype = PME

Tcoupl = v-rescale
tc-grps = system
tau-t = 0.1
ref-t = 1000.0 ; increase temperature to loosen membrane

Pcoupl = C-rescale
Pcoupltype = semiisotropic
tau-p = 5
ref-p = 0.1 0.1 ; decrease pressure to loosen membrane
compressibility = 4.5e-5 4.5e-5

gen-vel = no
gen-temp = 300.0
pbc = xyz
DispCorr = EnerPres
periodic-molecules = yes
