integrator = md
dt = 0.002
nsteps = 250000 ; 500 ps

continuation = no
constraints = h-bonds
constraint-algorithm = lincs

nstxout = 0
nstvout = 0
nstfout = 0
nstxout-compressed = 2500 ; 5 ps

nstlist = 40
vdwtype = PME
coulombtype = PME

Tcoupl = v-rescale
tc_grps = system
tau_t = 0.1
ref_t = 350.0 ; increase temperature to loosen membrane 

gen-vel = yes
gen-temp = 300.0
pbc = xyz
periodic-molecules= yes
DispCorr = EnerPres
